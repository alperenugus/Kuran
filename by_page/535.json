    },
    {
      "surah": 56,
      "ayah": 22,
      "sajda": false,
      "text": "وَحُورٌ ع۪ينٌۙ",
      "text_unicode": "وَحُورٌ عٖینٌۙ"
    },
    {
      "surah": 56,
      "ayah": 23,
      "sajda": false,
      "text": "كَاَمْثَالِ اللُّؤْلُؤِ۬ الْمَكْنُونِۚ",
      "text_unicode": "كَاَمْثَالِ اللُّؤْلُؤِ࣑ الْمَكْنُونِۚ"
    },
    {
      "surah": 56,
      "ayah": 24,
      "sajda": false,
      "text": "جَزَٓاءً بِمَا كَانُوا يَعْمَلُونَ",
      "text_unicode": "جَزَٓاءً بِمَا كَانُوا یَعْمَلُونَ"
    },
    {
      "surah": 56,
      "ayah": 25,
      "sajda": false,
      "text": "لَا يَسْمَعُونَ ف۪يهَا لَغْوًا وَلَا تَاْث۪يمًاۙ",
      "text_unicode": "لَا یَسْمَعُونَ فٖیهَا لَغْوًا وَلَا تَاْثٖیمًاۙ"
    },
    {
      "surah": 56,
      "ayah": 26,
      "sajda": false,
      "text": "اِلَّا ق۪يلًا سَلَامًا سَلَامًا",
