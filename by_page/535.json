    },
    {
      "surah": 56,
      "ayah": 33,
      "sajda": false,
      "text": "لَا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍۙ",
      "text_unicode": "لَا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍۙ"
